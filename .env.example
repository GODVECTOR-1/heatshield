# Copy to .env.local and fill in. Never commit .env.local.
# Supabase (server only for the service role key)
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Gemini (optional; board falls back to a template summary)
GEMINI_API_KEY=
GEMINI_MODEL=
# Live site tokens (demo tokens live in data/seed.json)
SITE_WORKER_JOIN_TOKEN=
